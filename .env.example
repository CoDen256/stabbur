# --- auth (D-N1: shared-bearer-token middleware, same shape as smia) ---
# Required on every route except /ui and /blob/* (D85). mjolnir/builder's
# own .env needs this exact same value as STABBUR_AUTH_TOKEN there, or
# builder's pulls will 401. Falls back to "changeme" if unset — never leave
# that default on a real deploy.
STABBUR_AUTH_TOKEN=<a long random token — same value as mjolnir's STABBUR_AUTH_TOKEN>
